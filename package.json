{
  "name": "src-mcp",
  "version": "1.0.3",
  "description": "MCP server for semantic code search and codebase analysis — Treesitter parsing, AST extraction, and embedding-based indexing for any LLM that supports MCP",
  "type": "module",
  "main": "./dist/public.mjs",
  "module": "./dist/public.mjs",
  "types": "./dist/public.d.mts",
  "exports": {
    ".": {
      "import": "./dist/public.mjs",
      "types": "./dist/public.d.mts"
    }
  },
  "bin": {
    "src-mcp": "dist/bin.mjs"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "cli": "tsx src/bin.ts",
    "serve": "tsx src/bin.ts serve",
    "build": "cross-env NODE_ENV=production tsdown",
    "prepublishOnly": "npm run check && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:retrieval": "tsx scripts/benchmark-retrieval.ts",
    "conformance:smoke": "tsx scripts/conformance.ts",
    "conformance:local": "tsx scripts/conformance-local.ts",
    "mutation:smoke": "tsx scripts/mutation-smoke.ts",
    "contract:verify": "tsx scripts/verify-contract-surface.ts",
    "pack:verify": "tsx scripts/verify-package.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .tsbuildinfo",
    "lint": "biome lint src scripts",
    "lint:fix": "biome lint --write src scripts",
    "format": "biome format --write src scripts",
    "format:check": "biome format src scripts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run contract:verify"
  },
  "overrides": {
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "sharp": "0.35.4"
  },
  "dependencies": {
    "@lancedb/lancedb": "0.38.0",
    "@langchain/core": "1.2.9",
    "@langchain/textsplitters": "1.0.1",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "apache-arrow": "18.1.0",
    "chokidar": "5.0.0",
    "citty": "0.2.2",
    "fast-glob": "3.3.3",
    "ignore": "7.0.9",
    "ollama": "0.6.3",
    "ora": "9.4.1",
    "picocolors": "1.1.1",
    "web-tree-sitter": "0.27.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "cross-env": "10.1.0",
    "tsdown": "0.23.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "semantic-search",
    "code-search",
    "code-intelligence",
    "llm",
    "ai-assistant",
    "ai-tools",
    "rag",
    "codebase-analysis",
    "code-indexing",
    "repository-analysis",
    "treesitter",
    "ast",
    "embeddings",
    "vector-search",
    "context-retrieval",
    "developer-tools",
    "typescript",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvnpetit/structured-repo-context-mcp.git"
  },
  "homepage": "https://github.com/kvnpetit/structured-repo-context-mcp#readme",
  "bugs": {
    "url": "https://github.com/kvnpetit/structured-repo-context-mcp/issues"
  },
  "author": "kvnpetit",
  "license": "MIT"
}
